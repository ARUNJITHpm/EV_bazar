# Secrets
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Data - large downloads, never in git
data/*
# ...except the small, essential VAHAN RTO seed (KL+TN office names + coords).
# It cannot be regenerated without an external project's data, and both the
# scraper and the ingest depend on it. Scrape outputs (data/vahan/scrape_*.csv)
# stay ignored.
!data/vahan/
data/vahan/*
!data/vahan/rto_reference.csv
# Public analytics is a reviewed allowlist, not the raw data tree.
!data/public/
data/public/*
!data/public/district_reference/
!data/public/rto_to_district/
!data/public/ev_registrations/
!data/public/public_chargers/
!data/public/ev_tariffs/
!data/public/district_boundaries/
!data/public/highways/
!data/public/discom_performance/
!data/public/supply_hours/
!data/public/state_ev_policies/
!data/public/nhai_wayside_amenities/
!data/public/osm_power/
data/public/*/*
!data/public/*/.gitkeep
!data/public/*/data.csv
!data/public/*/data.topojson
!data/public/*/data.geojson
!data/public/*/meta.json
!data/public/*/meta.template.json
!data/public/*/data.template.csv
!data/fixtures/
!data/fixtures/**
*.pbf
*.shp
*.shx
*.dbf
*.prj
*.osm

# Tariff PDFs are archived deliberately (PLAN 0.2) but not in git.
# Keep the index/metadata in the DB, the blobs in object storage.
tariffs/pdf/

# Design reference images: the owner's exported flow/UI artboards. Kept on
# disk as the design record, but not tracked - they are stripped from the HF
# mirror anyway and only slow the push. The design DOCS (DECISIONS.md,
# MAPBOX.md, brand/) stay tracked.
design/flow-images/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
openapi.json
frontend/dist/
frontend/node_modules/

# Font bytes are materialized from verified text assets at build time (HF mirror).
/frontend/public/analytics-fonts/*.ttf
/frontend/public/analytics-fonts/*.woff2
