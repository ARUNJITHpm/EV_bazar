# deploy/start.sh runs inside a Linux container; a CRLF checkout on Windows
# would break it at COPY time. Keep every shell script LF everywhere.
*.sh text eol=lf
Caddyfile text eol=lf
*.pdf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
