# Copy to .env. Never commit .env.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE ADDING AN API KEY
# ---------------------------------------------------------------------------
# AGENTS.md constraint 7 / OVERVIEW.md Rule 5:
#
#   No paid API call without a hard quota cap already configured in the
#   provider console AND a client-side counter.
#
# app/config.py enforces this. Setting an API key without a positive
# monthly cap and console_cap_confirmed=true makes the app refuse to start.
# That is not a bug. One runaway loop is Rs 40,000.
#
# There is a THIRD lock, and it fails later than the other two: a paid
# provider with no price card cannot be priced, so build_cascade() refuses to
# assemble it. Seed the cards before setting any key below:
#
#   uv run python -m scripts.seed_price_cards --write
# ---------------------------------------------------------------------------

ENV=dev
DEBUG=false

DATABASE_URL=postgresql+psycopg://evsite:evsite@localhost:5432/evsite

# --- L2 Nominatim (free, no account, no key) --------------------------------
# Two options, same API:
#   public   https://nominatim.openstreetmap.org - no setup at all. The usage
#            policy (identifying User-Agent, max 1 req/s) is enforced in code.
#            Comfortable at hundreds of reports/month; the cache means no
#            address is ever asked twice.
#   self-host  docker compose --profile geocoding up nominatim - parked until
#            volume demands it. The India import takes HOURS and ~80 GB disk.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Competitor inventory (PLAN 2.3) - Open Charge Map ----------------------
# Free key: openchargemap.org -> My Apps -> Register an Application. Station
# existence + specs (not occupancy). Blank = the competitor fetch is disabled.
# OPEN_CHARGE_MAP__API_KEY=

# --- L3 Ola Maps - 500k free/month, India only -----------------------------
# OLA_MAPS__API_KEY=
# OLA_MAPS__MONTHLY_CAP=400000
# OLA_MAPS__CONSOLE_CAP_CONFIRMED=false

# --- L4 Mappls -------------------------------------------------------------
# API_KEY is sent as an OAuth bearer token. Mappls prices per contract, so the
# shipped price card is a PLACEHOLDER - replace it with a new card (never edit
# the old one) once the plan is signed.
# MAPPLS__API_KEY=
# MAPPLS__MONTHLY_CAP=
# MAPPLS__CONSOLE_CAP_CONFIRMED=false

# --- L5 Google - bill through an INDIAN entity -----------------------------
# India-billed accounts get 70k free Essentials calls/month vs 10k global.
# Beyond that it is $5 per 1,000. Cap it low and mean it.
# GOOGLE_MAPS__API_KEY=
# GOOGLE_MAPS__MONTHLY_CAP=5000
# GOOGLE_MAPS__CONSOLE_CAP_CONFIRMED=false

# --- Operations console (PLAN C.0) -----------------------------------------
# The console shows CPO commercial terms and our own spend, so it is the most
# sensitive surface in the product. Generate both values with:
#
#   uv run python -m scripts.console_password
#
# Until they are set, every console endpoint returns 503 - unconfigured must
# never mean unprotected - and ENV=prod refuses to boot at all.
# Rotating CONSOLE_SECRET_KEY signs everyone out immediately.
# CONSOLE_OPERATOR=operator
# CONSOLE_SECRET_KEY=
# CONSOLE_PASSWORD_HASH=
# CONSOLE_SESSION_MAX_AGE_SECONDS=43200
# Local-dev only: skip the login entirely. Prod REFUSES TO BOOT with this set.
# CONSOLE_AUTH_DISABLED=true

# --- VAHAN EV registrations (PLAN 4.1) - no key, no account ----------------
# The demand layer's raw material: EV counts per district, scraped from the
# government dashboard by our own fetcher. No .env line is needed - it is a
# browser scrape, not an API. One-time setup installs the browser:
#   uv sync --extra scrape
# Then, per refresh (or via scripts\vahan_refresh.bat on a monthly schedule):
#   uv run python -m scripts.scrape_vahan --state kerala,tamilnadu
#   uv run python -m scripts.ingest_vahan --csv latest --write
# Smoke-test the scraper without writing:  scrape_vahan --dry-run --limit 2

# --- Poller (PLAN 0.1) -----------------------------------------------------
POLLER_INTERVAL_SECONDS=300
POLLER_DEADMAN_MINUTES=30

# --- Scraped CPO apps (PLAN 0.1) -------------------------------------------
# ChargeZone, Statiq, Kazam, chargeMOD, Tata Power EZ, Ather Grid, Jio-bp.
# For each one you want to poll:
#   1. Capture its stations endpoint (browser devtools / mitmproxy on the app).
#   2. Set <NAME>__BASE_URL (+ path, key) below. Nested delimiter is "__".
#   3. Record its terms + rate limit AND flip authorised=True in
#      app/domain/polling/sources.py. Config alone does NOT grant permission -
#      both locks are required, by design.
#   4. If the JSON shape differs, extend from_scraped_stations / SCRAPE_STATUS_MAP
#      in app/domain/polling/normalise.py.
# Validate quickly with no database:  uv run python -m workers.poller --dry-run
#
# CHARGEZONE__BASE_URL=https://api.chargezone.example
# CHARGEZONE__STATIONS_PATH=/stations
# CHARGEZONE__API_KEY=
# CHARGEZONE__RATE_LIMIT_PER_MINUTE=30
#
# STATIQ__BASE_URL=
# KAZAM__BASE_URL=
# CHARGEMOD__BASE_URL=
# TATA_POWER_EZ__BASE_URL=
# ATHER_GRID__BASE_URL=
# JIO_BP__BASE_URL=

# One token + URL per OCPI partner. The source must ALSO be marked
# authorised + enabled in app/domain/polling/sources.py - a token alone does
# not grant permission, and the registry refuses by default.
# POLL_OCPI_PARTNER_URL=https://partner.example/ocpi/cpo/2.2
# POLL_OCPI_PARTNER_TOKEN=
