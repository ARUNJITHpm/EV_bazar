<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler definition for the monthly VAHAN refresh (PLAN 4.1).

  Register it (edit the <Command> path to this checkout first):
    schtasks /Create /TN "EV_Bazar_VAHAN_Refresh" /XML scripts\vahan_etl_task.xml

  Monthly on the 1st at 02:00. Skipped on battery, so a laptop must be on mains -
  but the poller is the job that must never miss; a VAHAN snapshot a day late is
  harmless, because it is a fresh point in a series, not a stream that can gap.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>EV_Bazar VAHAN EV-registration monthly refresh (scrape + ingest)</Description>
    <URI>\EV_Bazar_VAHAN_Refresh</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT6H</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-09-01T02:00:00</StartBoundary>
      <ScheduleByMonth>
        <DaysOfMonth>
          <Day>1</Day>
        </DaysOfMonth>
        <Months>
          <January /><February /><March /><April /><May /><June />
          <July /><August /><September /><October /><November /><December />
        </Months>
      </ScheduleByMonth>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <!-- Edit this to the absolute path of scripts\vahan_refresh.bat -->
      <Command>D:\EV_Bazar\scripts\vahan_refresh.bat</Command>
    </Exec>
  </Actions>
</Task>
