# HF Space edition of the production topology (STACK.md section 8): Caddy
# serves the built SPA and proxies /api to uvicorn on the loopback. TLS is
# terminated by the Space's own front proxy, so plain HTTP here.
{
	admin off
	auto_https off
}

:8000 {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8001 {
			# Caddy does not trust the Space's front proxy, so it discards the
			# incoming X-Forwarded-For and writes its own (the front proxy's
			# address). Every visitor then looks like one of a handful of
			# proxy IPs to the per-IP throttle (api/internal/ratelimit.py).
			# Keep the chain the front proxy sent in a header only Caddy sets;
			# header_up REPLACES any value a caller supplies, so it cannot be
			# forged from outside.
			header_up X-Client-Chain {http.request.header.X-Forwarded-For}
		}
	}

	handle {
		root * /srv/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
