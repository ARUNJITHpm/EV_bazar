# HF Space edition of the production topology (STACK.md section 8): Caddy
# serves the built SPA and proxies /api to uvicorn on the loopback. TLS is
# terminated by the Space's own front proxy, so plain HTTP here.
{
	admin off
	auto_https off
}

:8000 {
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# Frame-ancestors is the modern clickjacking guard; the full script/
		# style CSP needs testing against Mapbox and fonts before it ships.
		Content-Security-Policy "frame-ancestors 'self' https://huggingface.co"
		-Server
	}

	# Largest legitimate body is an owner bill image (8 MiB cap in config.py).
	request_body {
		max_size 10MB
	}

	handle /robots.txt {
		respond "User-agent: *\nDisallow: /api/\nDisallow: /console\n" 200
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8001 {
			# Caddy does not trust the Space's front proxy, so it discards the
			# incoming X-Forwarded-For and writes its own (the front proxy's
			# address). Every visitor then looks like one of a handful of
			# proxy IPs to the per-IP throttle (api/internal/ratelimit.py).
			# Keep the chain the front proxy sent in a header only Caddy sets;
			# header_up REPLACES any value a caller supplies, so it cannot be
			# forged from outside.
			header_up X-Client-Chain {http.request.header.X-Forwarded-For}
		}
	}

	# Analytics documents are generated at build time. Unpublished paths get
	# an honest preparation page, never the empty JavaScript-only SPA shell.
	handle /data/district/* {
		root * /srv/frontend/dist
		try_files {path}/index.html {path} /data/district/index.html
		file_server
	}
	handle /data/insights/* {
		root * /srv/frontend/dist
		try_files {path}/index.html {path} /data/fallback.html
		file_server
	}
	handle /data/weekly/* {
		root * /srv/frontend/dist
		try_files {path}/index.html {path} /data/fallback.html
		file_server
	}
	@analytics path /data /data/*
	handle @analytics {
		root * /srv/frontend/dist
		try_files {path}/index.html {path} /data/fallback.html
		file_server
	}

	handle {
		root * /srv/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
